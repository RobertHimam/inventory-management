# Environment configuration for inventory-management microservices
# Copy this file to .env and adjust values as needed.
# DO NOT commit .env or .env.local to version control.

# Common
NODE_ENV=development # development, test, production
PORT=3000

# Database
MONGODB_URI=mongodb://mongodb:27017
AUTH_DB=auth_db
PRODUCT_DB=product_db
INVENTORY_DB=inventory_db
REPORT_DB=report_db
AUDIT_DB=audit_db

# RabbitMQ
RABBITMQ_URL=amqp://rabbitmq:5672
# RABBITMQ_EXCHANGE=inventory.events # optional per service
# RABBITMQ_DLQ_SUFFIX=.dlq # optional for audit-service

# JWT (auth-service, sse-service)
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting (gateway)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=10

# CORS (gateway)
CORS_ORIGINS=http://localhost:5173

# Service URLs (gateway)
AUTH_SERVICE_URL=http://auth-service:3000
PRODUCT_SERVICE_URL=http://product-service:3000
INVENTORY_SERVICE_URL=http://inventory-service:3000
REPORT_SERVICE_URL=http://report-service:3000
NOTIFICATION_SERVICE_URL=http://notification-service:3000
AUDIT_SERVICE_URL=http://audit-service:3000
SSE_SERVICE_URL=http://sse-service:3000

# SSE (gateway, sse-service)
SSE_ENABLED=true

# Frontend
VITE_API_URL=http://localhost:3000