{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": [
      "ES2022"
    ],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@types/*": [
        "packages/shared-types/src/*"
      ],
      "@events/*": [
        "packages/shared-events/src/*"
      ],
      "@auth/*": [
        "packages/shared-auth/src/*"
      ],
      "@rabbitmq/*": [
        "packages/shared-rabbitmq/src/*"
      ],
      "@logger/*": [
        "packages/shared-logger/src/*"
      ],
      "@testing/*": [
        "packages/shared-testing/src/*"
      ]
    },
    "baseUrl": ".",
    "ignoreDeprecations": "6.0"
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/node_modules",
    "**/dist"
  ]
}
